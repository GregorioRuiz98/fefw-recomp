diff --git a/runtime/src/gfx/nvn/nvn_spatial.spvasm b/runtime/src/gfx/nvn/nvn_spatial.spvasm
new file mode 100644
index 0000000..fd4abbe
--- /dev/null
+++ b/runtime/src/gfx/nvn/nvn_spatial.spvasm
@@ -0,0 +1,98 @@
+; SPDX-License-Identifier: GPL-3.0-or-later
+; Own spatial scaler: bilinear sampling at fractional camera jitter, no history.
+; spirv-as --target-env vulkan1.0 nvn_spatial.spvasm -o spatial.spv
+OpCapability Shader
+OpCapability StorageImageWriteWithoutFormat
+%glsl = OpExtInstImport "GLSL.std.450"
+OpMemoryModel Logical GLSL450
+OpEntryPoint GLCompute %main "main" %gid
+OpExecutionMode %main LocalSize 8 8 1
+OpDecorate %gid BuiltIn GlobalInvocationId
+OpDecorate %input DescriptorSet 0
+OpDecorate %input Binding 0
+OpDecorate %output DescriptorSet 0
+OpDecorate %output Binding 1
+OpDecorate %output NonReadable
+OpDecorate %Push Block
+OpMemberDecorate %Push 0 Offset 0
+OpMemberDecorate %Push 1 Offset 16
+OpMemberDecorate %Push 2 Offset 32
+%void = OpTypeVoid
+%fn = OpTypeFunction %void
+%bool = OpTypeBool
+%b2 = OpTypeVector %bool 2
+%uint = OpTypeInt 32 0
+%int = OpTypeInt 32 1
+%float = OpTypeFloat 32
+%u3 = OpTypeVector %uint 3
+%i2 = OpTypeVector %int 2
+%i4 = OpTypeVector %int 4
+%f2 = OpTypeVector %float 2
+%f4 = OpTypeVector %float 4
+%ptr_gid = OpTypePointer Input %u3
+%gid = OpVariable %ptr_gid Input
+%image = OpTypeImage %float 2D 0 0 0 1 Unknown
+%sampled = OpTypeSampledImage %image
+%ptr_sampled = OpTypePointer UniformConstant %sampled
+%input = OpVariable %ptr_sampled UniformConstant
+%storage = OpTypeImage %float 2D 0 0 0 2 Unknown
+%ptr_storage = OpTypePointer UniformConstant %storage
+%output = OpVariable %ptr_storage UniformConstant
+%Push = OpTypeStruct %f4 %f4 %i4
+%ptr_push = OpTypePointer PushConstant %Push
+%push = OpVariable %ptr_push PushConstant
+%ptr_pf4 = OpTypePointer PushConstant %f4
+%ptr_pi4 = OpTypePointer PushConstant %i4
+%zeroi = OpConstant %int 0
+%onei = OpConstant %int 1
+%twoi = OpConstant %int 2
+%zerof = OpConstant %float 0
+%half = OpConstant %float 0.5
+%half2 = OpConstantComposite %f2 %half %half
+%main = OpFunction %void None %fn
+%entry = OpLabel
+%gid3 = OpLoad %u3 %gid
+%gids = OpVectorShuffle %u3 %gid3 %gid3 0 1 2
+%gx = OpCompositeExtract %uint %gids 0
+%gy = OpCompositeExtract %uint %gids 1
+%ix = OpBitcast %int %gx
+%iy = OpBitcast %int %gy
+%pos = OpCompositeConstruct %i2 %ix %iy
+%pd = OpAccessChain %ptr_pi4 %push %twoi
+%dest = OpLoad %i4 %pd
+%size = OpVectorShuffle %i2 %dest %dest 2 3
+%inside2 = OpSLessThan %b2 %pos %size
+%inside = OpAll %bool %inside2
+OpSelectionMerge %done None
+OpBranchConditional %inside %body %done
+%body = OpLabel
+%ps = OpAccessChain %ptr_pf4 %push %zeroi
+%source = OpLoad %f4 %ps
+%pt = OpAccessChain %ptr_pf4 %push %onei
+%transform = OpLoad %f4 %pt
+%src_base = OpVectorShuffle %f2 %source %source 0 1
+%src_size = OpVectorShuffle %f2 %source %source 2 3
+%jitter = OpVectorShuffle %f2 %transform %transform 0 1
+%inverse = OpVectorShuffle %f2 %transform %transform 2 3
+%pf = OpConvertSToF %f2 %pos
+%center = OpFAdd %f2 %pf %half2
+%df = OpConvertSToF %f2 %size
+%relative = OpFDiv %f2 %center %df
+%scaled = OpFMul %f2 %relative %src_size
+%absolute = OpFAdd %f2 %scaled %src_base
+%offset = OpFAdd %f2 %absolute %jitter
+%lo = OpFAdd %f2 %src_base %half2
+%end = OpFAdd %f2 %src_base %src_size
+%hi = OpFSub %f2 %end %half2
+%clipped = OpExtInst %f2 %glsl FClamp %offset %lo %hi
+%uv = OpFMul %f2 %clipped %inverse
+%sampler = OpLoad %sampled %input
+%color = OpImageSampleExplicitLod %f4 %sampler %uv Lod %zerof
+%dst_base = OpVectorShuffle %i2 %dest %dest 0 1
+%dst_pos = OpIAdd %i2 %pos %dst_base
+%out = OpLoad %storage %output
+OpImageWrite %out %dst_pos %color
+OpBranch %done
+%done = OpLabel
+OpReturn
+OpFunctionEnd
