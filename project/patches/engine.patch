+// NVN2 root table 0 is exposed as c[24] by graphics shaders. Preserve the
+// recording-time bytes, including partial updates, independently for graphics/compute.
+void push_constants(NVNcommandBuffer* c, uint32_t compute, int table, int offset, int size, const void* data) {
+    if (table < 0 || table >= 8 || offset < 0 || size < 0 || offset > 1024 || size > 1024 - offset || (size && !data)) {
+        NXLOG_W("nvn", "NVN2 push constants rejected: table=%d offset=%d size=%d", table, offset, size);
+        return;
+    }
+    if (!size) return;
+    const P_PushConstants p{compute, uint32_t(table), uint32_t(offset), uint32_t(size)};
+    with_rec(c, [&](CmdList& l) { l.emit(Op::PushConstants, p, data, p.size); });
+}
+void nvnCommandBufferPushGraphicsConstants(NVNcommandBuffer* c, int table, int offset, int size, const void* data) {
+    push_constants(c, 0, table, offset, size, data);
+}
+void nvnCommandBufferPushComputeConstants(NVNcommandBuffer* c, int table, int offset, int size, const void* data) {
+    push_constants(c, 1, table, offset, size, data);
+}
+
 void register_api_cmd_state() {
