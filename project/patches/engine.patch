+    auto variant = std::make_unique<ShaderInfo>(*cs);
+    if (!spirv_int_textures(cs->spirv, changes, variant->spirv)) {
+        NXLOG_E(kTag, "cannot type integer texture reads for compute %s (%s)", cs->hash.c_str(), key.c_str());
+        g_integer_compute.emplace(cache_key, nullptr);
+        return nullptr;
+    }
+    for (auto& b : variant->refl.bindings)
+        for (const auto& c : changes)
+            if (b.set == c.set && b.binding == c.binding) b.image.component = c.is_signed ? ScalarType::Sint : ScalarType::Uint;
+    variant->hash += "-int-" + key;
+    NXLOG_I(kTag, "compute %s: integer texture variant %s", cs->hash.c_str(), key.c_str());
