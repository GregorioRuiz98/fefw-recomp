+struct NativeVideoImage {
+    uint32_t handle = 0, width = 0, height = 0;
+    int format = 0;
+    NVNdevice* device = nullptr;
+};
+std::mutex g_native_video_mu;
+std::map<uint64_t, NativeVideoImage> g_native_video;
+
+void native_video_initialize(::Ctx* c) {
+    const uint64_t object = c->x[0], builder = c->x[1];
+    NativeVideoImage image;
+    uint32_t permission = 0;
+    if (!object || !builder) { c->x[0] = 0; return; }
+    // SDK 22 builder layout, verified from its five exported setters.
+    std::memcpy(&image.device, reinterpret_cast<void*>(builder), 8);
+    std::memcpy(&image.handle, reinterpret_cast<void*>(builder + 8), 4);
+    std::memcpy(&permission, reinterpret_cast<void*>(builder + 12), 4);
+    std::memcpy(&image.format, reinterpret_cast<void*>(builder + 16), 4);
+    if (permission != 1 || (image.format != NVN_FORMAT_RGBA8 && image.format != NVN_FORMAT_RGBA8_SRGB) ||
+        !media::video_native_image_info(image.handle, &image.width, &image.height)) {
+        NXLOG_W("nvn", "native video image rejected: handle=%x format=%d permission=%u", image.handle, image.format, permission);
+        c->x[0] = 0; return;
+    }
+    std::lock_guard<std::mutex> lk(g_native_video_mu);
+    g_native_video[object] = image;
+    c->x[0] = 1;
+}
+void native_video_texture(::Ctx* c) {
+    auto* guest = reinterpret_cast<NVNtexture*>(c->x[0]);
+    NativeVideoImage image;
+    {
+        std::lock_guard<std::mutex> lk(g_native_video_mu);
+        auto it = g_native_video.find(c->x[1]);
+        if (!guest || it == g_native_video.end()) { c->x[0] = 0; return; }
+        image = it->second;
+    }
+    TextureBuilderInfo b;
+    b.device = image.device; b.flags = NVN_TEXTURE_FLAGS_LINEAR;
+    b.target = NVN_TEXTURE_TARGET_2D; b.format = image.format;
+    b.width = image.width; b.height = image.height; b.depth = 1;
+    b.stride = image.width * 4;
+    const TexLayout layout = be::compute_texture_layout(b);
+    if (!layout.valid) { c->x[0] = 0; return; }
+    auto* t = new Texture();
+    t->b = b; t->fmt = layout.fmt; t->storage_size = layout.storage_size;
+    t->block_linear = false; t->levels = t->layers = 1;
+    t->id = next_texture_id(b.device);
+    t->video_native_handle = image.handle;
+    t->video_pixels.resize(layout.storage_size);
+    t->mem = t->video_pixels.data();
+    // First upload and later frame refreshes occur on the render thread.
+    if (Texture* old = tex_of(guest)) {
+        old->destroyed.store(true);
+        gpu::release_texture_gpu(old);
+        be::texture_registry_remove(old);
+        be::texture_registry_remove_virtual(old);
+    } else g_textures.add(1);
+    be::bind_guest(guest, t);
+    be::texture_registry_add(t);
+    g_textures_created.add(1);
+    be::g_tex_scan_epoch.fetch_add(1, std::memory_order_relaxed);
+    NXLOG_I("nvn", "native video texture %u: %ux%u handle=%x", t->id, image.width, image.height, image.handle);
+    c->x[0] = 1;
+}
+void native_video_finalize(::Ctx* c) {
+    std::lock_guard<std::mutex> lk(g_native_video_mu);
+    g_native_video.erase(c->x[0]);
+}
+
 }  // namespace
 
 void register_api_texture() {
+    const struct { const char* name; HleFn fn; } native[] = {
+        {"_Z24nvnNativeImageInitializeP14NVNnativeImagePK21NVNnativeImageBuilder", native_video_initialize},
+        {"_Z35nvnTextureInitializeFromNativeImageP10NVNtextureP14NVNnativeImage", native_video_texture},
+        {"_Z22nvnNativeImageFinalizeP14NVNnativeImage", native_video_finalize},
+    };
+    for (const auto& item : native) { hle_register(item.name, item.fn); module_override_symbol(item.name); }
     NVN_REG(nvnTextureInitialize);
     NVN_REG(nvnTextureFinalize);
     NVN_REG(nvnTextureSetDebugLabel);
