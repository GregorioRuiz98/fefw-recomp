+    auto& s = dlss_params[p]; s.ix = x; s.iy = y;
+}
+void nvnDlssParametersSetOutputSubrectangleBase(void* p, int x, int y) {
+    std::lock_guard<std::mutex> lock(dlss_params_mutex);
+    auto& s = dlss_params[p]; s.ox = x; s.oy = y;
+}
+void nvnDlssParametersSetJitterOffset(void* p, float x, float y) {
+    std::lock_guard<std::mutex> lock(dlss_params_mutex);
+    auto& s = dlss_params[p]; s.jitter_x = x; s.jitter_y = y;
+}
+void nvnCommandBufferEvaluateDlss(NVNcommandBuffer* cmd, const void* network, const void* params) {
+    (void)network;
+    if (!config_get_int("nvn", "dlss_spatial_fallback", 0)) {
+        static std::once_flag once;
+        std::call_once(once, [] { NXLOG_W("nvn", "DLSS evaluation unavailable; spatial diagnostic fallback disabled"); });
+        return;
+    }
+    DlssSpatialParams p;
+    {
+        std::lock_guard<std::mutex> lock(dlss_params_mutex);
+        auto it = dlss_params.find(params);
+        if (it == dlss_params.end()) return;
+        p = it->second;
+    }
+    Texture* s = host_of<Texture>(p.input);
+    Texture* d = host_of<Texture>(p.output);
+    auto color_format = [](int f) { return f == NVN_FORMAT_RGBA8 || f == NVN_FORMAT_RGBA16F || f == NVN_FORMAT_RGBA32F || f == NVN_FORMAT_R11G11B10F; };
+    if (!s || !d || s == d || p.has_input_view || p.has_output_view ||
+        !color_format(s->b.format) || !color_format(d->b.format) ||
+        s->b.target != NVN_TEXTURE_TARGET_2D || d->b.target != NVN_TEXTURE_TARGET_2D ||
+        s->b.samples > 1 || d->b.samples > 1 || p.width <= 0 || p.height <= 0 ||
+        p.ix < 0 || p.iy < 0 || p.ox < 0 || p.oy < 0 || p.ix > s->b.width || p.iy > s->b.height ||
+        p.width > s->b.width - p.ix || p.height > s->b.height - p.iy ||
+        p.ox >= d->b.width || p.oy >= d->b.height ||
+        !std::isfinite(p.jitter_x) || !std::isfinite(p.jitter_y) ||
+        std::abs(p.jitter_x) > 1.0f || std::abs(p.jitter_y) > 1.0f) {
+        NXLOG_W("nvn", "DLSS spatial diagnostic rejected unsupported view or rectangle");
+        return;
+    }
+    static std::once_flag once;
+    std::call_once(once, [] { NXLOG_W("nvn", "DLSS spatial diagnostic active: color-only linear scaling, no temporal reconstruction"); });
+    NVNcopyRegion sr{p.ix, p.iy, 0, p.width, p.height, 1};
+    NVNcopyRegion dr{p.ox, p.oy, 0, d->b.width - p.ox, d->b.height - p.oy, 1};
+    if (config_get_bool("nvn", "dlss_dejitter", true) && (p.jitter_x != 0 || p.jitter_y != 0)) {
+        std::unique_lock<std::mutex> lk;
+        CommandBuffer* cb = begin_record(cmd, lk);
+        if (!cb) return;
+        P_SpatialScale work = zeroed<P_SpatialScale>();
+        work.src = s; work.dst = d;
+        work.src_region = {p.ix, p.iy, 0, p.width, p.height, 1};
+        work.dst_region = {p.ox, p.oy, 0, d->b.width - p.ox, d->b.height - p.oy, 1};
+        work.jitter_x = p.jitter_x; work.jitter_y = p.jitter_y;
+        cb->rec->hold(s); cb->rec->hold(d);
+        cb->rec->emit(Op::SpatialScale, work);
+        return;
+    }
+    nvnCommandBufferCopyTextureToTexture(cmd, p.input, nullptr, &sr, p.output, nullptr, &dr, NVN_COPY_FLAGS_LINEAR_FILTER_BIT);
+}
